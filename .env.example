# PARALLAX environment -- TEMPLATE ONLY, no real values.
#
#   cp .env.example .env      # then fill in every blank
#
# .env is gitignored and must stay that way: this repository is PUBLIC
# (github.com/proxy303-wq/Parallax).  Every variable below was a live credential
# at some point, so a leak is a real account takeover, not a nuisance.
#
# On Kuberns these values go in the service environment's Environment Variables
# page, never in the repository.  See deploy/kuberns.md.

# ------------------------------------------------------------------- Dhan ----
# Live broker session.  The access token expires daily; DHAN_PIN + DHAN_TOTP_SECRET
# let dhan_auth.py mint a fresh one, which is why all four are needed even though
# the token is short-lived.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_PIN=
DHAN_TOTP_SECRET=

# --------------------------------------------------------------- Telegram ----
PARALLAX_TELEGRAM_BOT_TOKEN=
PARALLAX_TELEGRAM_CHAT_ID=

# -------------------------------------------------------------- LLM / APIs ---
DEEPSEEK_API_KEY=
TYPESAFE_API_KEY=

# ---------------------------------------------------------- Delta Exchange ---
# Crypto futures venue used by parallax/apps/worker/crypto_smc.py.
DELTA_API_KEY=
DELTA_API_SECRET=

# ----------------------------------------------------------------- storage ---
# Postgres DSN.  When unset the journal, the open-position state and the Dhan
# token fall back to local files (parallax.db, .dhan_token.txt).  That is correct
# on a single box and wrong on a PaaS: each process is its own container with its
# own ephemeral filesystem, so every worker would re-authenticate against Dhan
# and invalidate the others' token, and the journal would reset on every deploy.
#
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
#
# Build it from the Kuberns datastore Overview page (database name, username,
# password, hostname).  Kuberns documents those fields; it does NOT document
# injecting a ready-made DATABASE_URL, so assume you must set this yourself.
PARALLAX_DB_URL=

# ----------------------------------------------------------------- optional ---
# Only consulted when PARALLAX_DB_URL is unset / for container-local tuning.
# PARALLAX_DB=parallax.db
# DHAN_TOKEN_FILE=.dhan_token.txt
# PARALLAX_SCRIP_MASTER=/app/data/security_id_list.csv
# PORT=8000
